{
  "@context": {
    "dcat": "http://www.w3.org/ns/dcat#",
    "dct": "http://purl.org/dc/terms/",
    "foaf": "http://xmlns.com/foaf/0.1/"
  },
  "@type": "dcat:Catalog",
  "@id": "https://github.com/cheer710815-hub/apttosell-subscription-data",
  "dct:title": "AptToSell South Korea Housing Subscription Data Catalog",
  "dct:description": "Public reference datasets for South Korea housing subscription scoring and private-housing deposit requirements.",
  "dct:publisher": {
    "@type": "foaf:Agent",
    "foaf:name": "AptToSell"
  },
  "dct:license": "https://creativecommons.org/licenses/by/4.0/",
  "dct:language": "ko",
  "dcat:dataset": [
    {
      "@type": "dcat:Dataset",
      "@id": "https://apttosell.com/cheongyak-score-data/",
      "dct:title": "Korea Housing Subscription Score 2026",
      "dct:description": "South Korea private-housing subscription 84-point reference table covering homeless period, dependents, and subscription-account period.",
      "dct:spatial": "South Korea",
      "dct:license": "https://creativecommons.org/licenses/by/4.0/",
      "dcat:distribution": [
        {
          "@type": "dcat:Distribution",
          "dct:format": "text/csv",
          "dcat:downloadURL": "https://raw.githubusercontent.com/cheer710815-hub/apttosell-subscription-data/main/housing_subscription_score_2026.csv"
        },
        {
          "@type": "dcat:Distribution",
          "dct:format": "application/json",
          "dcat:downloadURL": "https://raw.githubusercontent.com/cheer710815-hub/apttosell-subscription-data/main/housing_subscription_score_2026.json"
        }
      ]
    },
    {
      "@type": "dcat:Dataset",
      "@id": "https://apttosell.com/private-housing-deposit-data/",
      "dct:title": "Korea Private Housing Subscription Deposit 2026",
      "dct:description": "South Korea private-housing subscription deposit reference table by housing size and applicant residence area.",
      "dct:spatial": "South Korea",
      "dct:license": "https://creativecommons.org/licenses/by/4.0/",
      "dcat:distribution": [
        {
          "@type": "dcat:Distribution",
          "dct:format": "text/csv",
          "dcat:downloadURL": "https://raw.githubusercontent.com/cheer710815-hub/apttosell-subscription-data/main/private_housing_deposit_2026.csv"
        }
      ]
    }
  ]
}
