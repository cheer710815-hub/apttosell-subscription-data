      "encodingFormat": "text/csv",
      "contentUrl": "https://raw.githubusercontent.com/cheer710815-hub/apttosell-subscription-data/main/datasets/followup-event-registry-2026/FOLLOWUP-NOTICE-ID-CROSSWALK-v0.1.csv"
    }
  ],
  "variableMeasured": [
    "apttosell_project_id",
    "official_followup_notice_id",
    "derived_first_followup_date",
    "verification_status"
  ]
}
