  "creator": {
    "@type": "Person",
    "name": "Eun Kim",
    "sameAs": "https://orcid.org/0009-0006-9445-4768"
  },
  "publisher": {
    "@type": "Organization",
    "name": "AptToSell",
    "url": "https://apttosell.com/"
  },
  "spatialCoverage": {
    "@type": "Place",
    "name": "South Korea"
  },
  "temporalCoverage": "2026",
  "distribution": [
    {
      "@type": "DataDownload",
      "encodingFormat": "text/csv",
      "contentUrl": "https://raw.githubusercontent.com/cheer710815-hub/apttosell-subscription-data/main/datasets/followup-event-registry-2026/apttosell-first-followup-events-pilot-v0.1.csv"
    },
    {
