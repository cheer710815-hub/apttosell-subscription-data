{
  "@context": "https://schema.org",
  "@type": "Dataset",
  "name": "AptToSell Follow-Up Event Registry 2026 — Pilot",
  "description": "Pilot event-level registry for 103 observed first follow-up apartment supply events in South Korea, linked to stable AptToSell project IDs. Numeric first-event notice IDs are recovered for all 103 events; direct primary-source coverage remains incomplete.",
  "url": "https://github.com/cheer710815-hub/apttosell-subscription-data/tree/main/datasets/followup-event-registry-2026",
  "version": "0.1-pilot",
  "dateModified": "2026-10-05",
